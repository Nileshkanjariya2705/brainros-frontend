# Copy this file to `.env` and fill in real values.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Base URL of your backend API
VITE_API_BASE_URL=http://localhost:8000/api

# App display name
VITE_APP_NAME=React Vite Boilerplate

# Request timeout in milliseconds
VITE_API_TIMEOUT=15000

# Authentication & Registration Routes Switch (true/false)
VITE_ENABLE_AUTH_ROUTES=true

# Contact & Inquiries Email
VITE_CONTACT_EMAIL=info@brainros.com
